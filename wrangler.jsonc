{
  "name": "roomy-page-workbench",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": true,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "WORKBENCH_IDEMPOTENCY",
      "id": "d98de5da257a43a59941ed6945e53bf5"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
